# Hikari 会自动读取工作目录下的 .env；同名的进程环境变量优先。
# 支持空行、# 注释、可选的 export 前缀和单双引号；不会展开 $VAR / ${VAR}。
# 值里含空白、# 或 shell 元字符时请加引号。

# NapCat HTTP 接口
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_TOKEN=your-napcat-token

# 被观察的 QQ 号，逗号分隔；留空或不填表示观察所有人
OBSERVED_QQS=10001

# 目标群号，逗号分隔；扫描与运行日志都作用于这些群
QQ_GROUP_IDS=123456,789012

# 管理员 QQ 号，逗号分隔。管理员可用「✨ 内容」手动补录、用 💦 引用作废；
# 也可先发一条只有 💤 的消息，再由本人给它点 💤 回应，暂停本群本轮收录
ADMIN_QQS=20001,20002

# 每日扫描时刻，24 小时制 HH:MM，本地时区。窗口为前一天同一时刻到这一时刻
SCAN_TIME=03:00

# Hitokoto 兼容接口监听地址
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Redis：redis://[:password@]host:port/db
REDIS_URL=redis://127.0.0.1:6379/0

# 可选：Tesseract 模型目录。生产建议复制系统 tessdata 目录后，用官方
# tessdata_best 的 chi_sim / chi_sim_vert / eng 三个 traineddata 覆盖对应模型；
# best 简中模型会自动加载 chi_sim_vert，缺它时横排虽能识别但会报错且没有竖排能力。
OCR_TESSDATA_DIR=/opt/hikari/tessdata
